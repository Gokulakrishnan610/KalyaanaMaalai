# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://wedding:wedding@localhost:5432/wedding

# --- Login ---
SECRET_KEY=dev-only-secret-change-me-0123456789
LOGIN_MINUTES=720

# --- Redis: live updates and background jobs ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
ENVIRONMENT=dev
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
# true = AI, Razorpay, Telegram and email return fake answers (safe for demos)
MOCK_EXTERNALS=true

# --- AI ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Payment links: the fake checkout is dev-only. Set true only for a public demo where no real money should move ---
ALLOW_DEMO_PAYMENTS=false

# --- Razorpay TEST keys ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (Mailtrap sending: host live.smtp.mailtrap.io, user api, password = your API token) ---
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=
MAIL_FROM=Shaandaar Events <hello@your-verified-domain.com>
