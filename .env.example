# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://wedding:wedding@localhost:5432/wedding

# --- Login ---
SECRET_KEY=dev-only-secret-change-me-0123456789
LOGIN_MINUTES=720

# --- App ---
ENVIRONMENT=dev
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
# true = AI, Razorpay, Telegram and email return fake answers (safe for demos)
MOCK_EXTERNALS=true

# --- AI ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Razorpay TEST keys ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (Mailtrap) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
