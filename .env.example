# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://wedding:wedding@localhost:5432/wedding

# --- Login ---
SECRET_KEY=dev-only-secret-change-me-0123456789
LOGIN_MINUTES=720

# --- Redis: live updates and background jobs ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
ENVIRONMENT=dev
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
# true = AI, Razorpay, Telegram and email return fake answers (safe for demos)
MOCK_EXTERNALS=true

# --- AI ---
# Groq reads quotation PDFs and writes checklists. Get a key at console.groq.com/keys.
GROQ_API_KEY=
# optional: the text model (default openai/gpt-oss-120b) and the model that reads photos and scanned PDFs
# (default qwen/qwen3.8-27b). Names can change on Groq's side; see console.groq.com/docs/models.
GROQ_MODEL=
GROQ_VISION_MODEL=
# true = call Groq for real even while MOCK_EXTERNALS is true (payments, email and Telegram stay fake)
AI_LIVE=false

# --- Payment links: the fake checkout is dev-only. Set true only for a public demo where no real money should move ---
ALLOW_DEMO_PAYMENTS=false

# --- Razorpay TEST keys ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (Mailtrap sending: host live.smtp.mailtrap.io, user api, password = your API token) ---
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=
MAIL_FROM=Shaandaar Events <hello@your-verified-domain.com>
